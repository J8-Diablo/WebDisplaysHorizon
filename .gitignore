# Rust build output
target/

# Copied from Horizon by tools/check.sh; the launcher builds with its own.
/native/api/Cargo.lock
/tools/dev-logic/Cargo.lock

# Packed mods
*.hmod
*.hnmod

# CEF binaries and the browser profile (downloaded or built, never committed)
/host/cef/
/host/dist/
*.pak
*.dll
*.bin
*.dat

# Editors and OS
.vscode/
.idea/
__pycache__/
*.pyc
Thumbs.db
dist/

# tools/check.sh stages the manifest with the HCEF dependency here.
/native/.check/

# The content mod the native mod carries (tools/pack.py writes it): committed, because a build
# from this folder compiles it in.
!/native/data/*.hmod
